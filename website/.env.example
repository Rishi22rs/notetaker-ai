# Installer files are served from /public/downloads by default.
# Override either URL only when hosting installers on a separate CDN.
# VITE_MAC_DOWNLOAD_URL=https://cdn.example.com/UNYON-1.0.0-arm64.dmg
# VITE_WINDOWS_DOWNLOAD_URL=https://cdn.example.com/UNYON-Setup-1.0.0.exe

VITE_MAC_DOWNLOAD_ENABLED=true
VITE_WINDOWS_DOWNLOAD_ENABLED=false

# Production HTTPS backend origin for the admin login.
# Override with http://127.0.0.1:8787 to use a local backend.
VITE_AUTH_SERVER_URL=https://api.myunyon.com
